Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", " ", 
   RowBox[{"i", "<", 
    RowBox[{
     RowBox[{"Length", "[", "\[Lambda]Range", "]"}], "+", "1"}]}], ",", " ", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]", " ", "=", " ", 
     RowBox[{"\[Lambda]Range", "[", 
      RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ext\[CapitalPi]Vals", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         RowBox[{"2", " ", 
          SuperscriptBox["\[Pi]", "2"]}]], " ", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[Gamma]", " ", 
             FractionBox[
              SuperscriptBox["p", "2"], "k"], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "3"}], " ", "\[Lambda]", " ", 
                RowBox[{"GPlusField", "[", 
                 RowBox[{"\[Chi]", ",", " ", "\[Chi]"}], "]"}]}], " ", "+", 
               " ", 
               RowBox[{"\[CapitalDelta]m2", "[", "p", "]"}], "+", " ", 
               RowBox[{
                RowBox[{"\[CapitalDelta]\[Lambda]", "[", "p", "]"}], " ", 
                FractionBox[
                 RowBox[{"2", " ", 
                  SuperscriptBox["\[Gamma]", "2"]}], "\[Lambda]"], " ", 
                SuperscriptBox["\[Chi]", "2"]}]}], ")"}]}], "/.", 
            RowBox[{"p", "->", 
             RowBox[{"\[Gamma]", " ", 
              RowBox[{"Log", "[", 
               FractionBox["1", "k"], "]"}]}]}]}], "/.", "allParams"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", "1"}], "}"}], ",", " ", 
          RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}], ",", " ", 
          RowBox[{"MaxRecursion", "->", "40"}]}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Chi]", ",", " ", 
         RowBox[{"\[Chi]0", "/.", "allParams"}], ",", " ", "infinity", ",", 
         " ", "\[CapitalDelta]\[Chi]Ext"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"extData", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ext\[Chi]Range", "[", 
          RowBox[{"[", "n", "]"}], "]"}], ",", " ", 
         RowBox[{"ext\[CapitalPi]Vals", "[", 
          RowBox[{"[", "n", "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "1", ",", " ", 
         RowBox[{"Length", "[", "ext\[Chi]Range", "]"}]}], "}"}]}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"ext\[CapitalPi]", " ", "=", " ", 
     RowBox[{"Interpolation", "[", "extData", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"int\[CapitalPi]Vals", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         RowBox[{"2", " ", 
          SuperscriptBox["\[Pi]", "2"]}]], " ", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[Gamma]", " ", 
             FractionBox[
              SuperscriptBox["p", "2"], "k"], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "3"}], " ", "\[Lambda]", " ", 
                RowBox[{"GMinusField", "[", 
                 RowBox[{"\[Chi]", ",", " ", "\[Chi]"}], "]"}]}], " ", "+", 
               " ", 
               RowBox[{"\[CapitalDelta]m2", "[", "p", "]"}], "+", " ", 
               RowBox[{
                RowBox[{"\[CapitalDelta]\[Lambda]", "[", "p", "]"}], " ", 
                FractionBox[
                 RowBox[{"2", " ", 
                  SuperscriptBox["\[Gamma]", "2"]}], "\[Lambda]"], " ", 
                SuperscriptBox["\[Chi]", "2"]}]}], ")"}]}], "/.", 
            RowBox[{"p", "->", 
             RowBox[{"\[Gamma]", " ", 
              RowBox[{"Log", "[", 
               FractionBox["1", "k"], "]"}]}]}]}], "/.", "allParams"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", "1"}], "}"}], ",", " ", 
          RowBox[{"Method", "\[Rule]", "\"\<GlobalAdaptive\>\""}], ",", " ", 
          RowBox[{"MaxRecursion", "->", "40"}]}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Chi]", ",", " ", "origin", ",", " ", 
         RowBox[{"\[Chi]0", "/.", "allParams"}], ",", " ", 
         "\[CapitalDelta]\[Chi]Int"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"intData", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"int\[Chi]Range", "[", 
          RowBox[{"[", "n", "]"}], "]"}], ",", " ", 
         RowBox[{"int\[CapitalPi]Vals", "[", 
          RowBox[{"[", "n", "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "1", ",", " ", 
         RowBox[{"Length", "[", "int\[Chi]Range", "]"}]}], "}"}]}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"int\[CapitalPi]", " ", "=", " ", 
     RowBox[{"Interpolation", "[", "intData", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"\[CapitalPi]", " ", "=", " ", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"Join", "[", 
       RowBox[{"intData", ",", " ", 
        RowBox[{"Delete", "[", 
         RowBox[{"extData", ",", "1"}], "]"}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"\[Delta]\[Phi]1Vals", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             FractionBox["v", 
              RowBox[{"\[Gamma]", " ", 
               RowBox[{"(", 
                RowBox[{"1", " ", "-", " ", 
                 SuperscriptBox["y", "2"]}], ")"}]}]], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"GField", "[", 
                RowBox[{"x", ",", " ", "y"}], "]"}], "/.", 
               RowBox[{"p", "->", "pMin"}]}], ")"}], " ", 
             RowBox[{"\[CapitalPi]", "[", "y", "]"}], " ", "y"}], "/.", 
            "allParams"}], ",", " ", "10"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"y", ",", " ", 
           RowBox[{"\[Chi]0", "/.", "allParams"}], ",", " ", "infinity"}], 
          "}"}], ",", " ", 
         RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
        "x", ",", " ", "origin", ",", " ", "infinity", ",", " ", 
         "\[CapitalDelta]x"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"\[Delta]\[Phi]2Vals", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             FractionBox["v", 
              RowBox[{"\[Gamma]", " ", "y", " ", 
               SqrtBox[
                RowBox[{
                 SuperscriptBox["g", "2"], " ", "+", " ", 
                 SuperscriptBox["y", "2"]}]]}]], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"GField", "[", 
                RowBox[{"x", ",", " ", "y"}], "]"}], "/.", 
               RowBox[{"p", "->", "pMin"}]}], ")"}], " ", 
             RowBox[{"\[CapitalPi]", "[", "y", "]"}], " ", "y"}], "/.", 
            "allParams"}], ",", " ", "10"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"y", ",", " ", "origin", ",", " ", 
           RowBox[{"\[Chi]0", "/.", "allParams"}]}], "}"}], ",", " ", 
         RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
        "x", ",", " ", "origin", ",", " ", "infinity", ",", " ", 
         "\[CapitalDelta]x"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"\[Delta]\[Phi]Data", " ", "=", " ", 
     RowBox[{"Delete", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"xRange", "[", 
            RowBox[{"[", "n", "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
             "\[Delta]\[Phi]1Vals", " ", "+", " ", "\[Delta]\[Phi]2Vals"}], 
             ")"}], "[", 
            RowBox[{"[", "n", "]"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "1", ",", " ", 
           RowBox[{"Length", "[", "xRange", "]"}]}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"\[Delta]\[Phi]", " ", "=", " ", 
     RowBox[{"Interpolation", "[", "\[Delta]\[Phi]Data", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"classicalForce", "[", "s_", "]"}], " ", ":=", 
     RowBox[{"Evaluate", "[", 
      RowBox[{
       FractionBox["1", 
        SuperscriptBox["M", "2"]], " ", "v", " ", 
       RowBox[{"\[Chi]", "[", "s", "]"}], " ", "v", " ", 
       RowBox[{
        RowBox[{"\[Chi]", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"quantumForce", "[", "s_", "]"}], ":=", 
     RowBox[{"Evaluate", "[", 
      RowBox[{
       FractionBox["1", 
        SuperscriptBox["M", "2"]], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"v", " ", 
          RowBox[{"\[Chi]", "[", "s", "]"}]}], " ", "+", " ", 
         RowBox[{"\[Delta]\[Phi]", "[", 
          RowBox[{"\[Chi]", "[", "s", "]"}], "]"}]}], ")"}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"v", " ", 
           RowBox[{"\[Chi]", "[", "s", "]"}]}], " ", "+", " ", 
          RowBox[{"\[Delta]\[Phi]", "[", 
           RowBox[{"\[Chi]", "[", "s", "]"}], "]"}]}], ",", " ", "s"}], 
        "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"\[Lambda]data", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{"\[Lambda]data", ",", " ", 
       RowBox[{"{", 
        RowBox[{"100", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            FractionBox[
             RowBox[{
              RowBox[{"classicalForce", "[", "s", "]"}], " ", "-", " ", 
              RowBox[{"quantumForce", "[", "s", "]"}]}], 
             RowBox[{"classicalForce", "[", "s", "]"}]], "/.", 
            RowBox[{"s", "->", 
             FractionBox["1", 
              RowBox[{"2", " ", "\[Gamma]"}]]}]}], "/.", "allParams"}], 
          ")"}]}], "}"}]}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
