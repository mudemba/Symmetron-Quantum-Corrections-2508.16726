Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalTheta]", "[", "s_", "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", 
        RowBox[{"s", "<", "0"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        FractionBox["1", "2"], ",", " ", 
        RowBox[{"s", " ", "==", " ", "0"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"s", ">", " ", "0"}]}], "}"}]}], "}"}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"faster", " ", "step", " ", "function"}], "*)"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]", "[", "s_", "]"}], ":=", " ", 
   RowBox[{"\[Rho]0", " ", 
    RowBox[{"UnitStep", "[", 
     RowBox[{"-", "s"}], "]"}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"density", " ", "distributions"}], "*)"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"P", "[", 
    RowBox[{"\[Mu]_", ",", " ", "x_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{"1", "+", "x"}], 
        RowBox[{"1", "-", "x"}]], ")"}], 
      RowBox[{"\[Mu]", "/", "2"}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"3", " ", 
        SuperscriptBox["x", "2"]}], "-", 
       RowBox[{"3", " ", "x", " ", "\[Mu]"}], "+", 
       SuperscriptBox["\[Mu]", "2"]}], ")"}]}], 
    RowBox[{"Gamma", "[", 
     RowBox[{"3", "-", "\[Mu]"}], "]"}]]}], " ", 
  RowBox[{"(*", 
   RowBox[{"exterior", " ", "eigenmode"}], "*)"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F", "[", 
    RowBox[{"\[Alpha]_", ",", " ", "z_"}], "]"}], ":=", " ", 
   FractionBox[
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"2", " ", "\[Alpha]"}]}]], " ", 
     SuperscriptBox["z", "\[Alpha]"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SqrtBox[
         RowBox[{"1", "+", "z"}]]}], ")"}], 
      RowBox[{
       RowBox[{"-", "2"}], " ", "\[Alpha]"}]], " ", 
     RowBox[{"(", 
      RowBox[{"2", "+", 
       RowBox[{"3", " ", "z"}], "+", 
       RowBox[{"6", " ", 
        SqrtBox[
         RowBox[{"1", "+", "z"}]], " ", "\[Alpha]"}], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["\[Alpha]", "2"]}]}], ")"}]}], 
    RowBox[{"1", "+", 
     RowBox[{"3", " ", "\[Alpha]"}], "+", 
     RowBox[{"2", " ", 
      SuperscriptBox["\[Alpha]", "2"]}]}]]}], " ", 
  RowBox[{"(*", 
   RowBox[{"interior", " ", "eigenmode"}], "*)"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", "s_", "]"}], ":=", 
   RowBox[{"Tanh", "[", 
    RowBox[{
     RowBox[{"\[Gamma]", " ", "s"}], " ", "+", " ", 
     RowBox[{"ArcTanh", "[", "\[Chi]0", "]"}]}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"exterior", " ", "substitution"}], "*)"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z", "[", "s_", "]"}], " ", ":=", " ", 
   SuperscriptBox[
    RowBox[{"Csch", "[", 
     RowBox[{
      RowBox[{"ArcCsch", "[", 
       FractionBox["\[Chi]0", "g"], "]"}], " ", "-", " ", 
      RowBox[{"g", " ", "\[Gamma]", " ", "s"}]}], "]"}], "2"]}], " ", 
  RowBox[{"(*", 
   RowBox[{"interior", " ", "substitution"}], "*)"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Chi]Ext", "[", "s_", "]"}], ":=", 
   RowBox[{"Tanh", "[", 
    RowBox[{
     RowBox[{"\[Gamma]", " ", "s"}], " ", "+", " ", 
     RowBox[{"ArcTanh", "[", "\[Chi]0", "]"}]}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"exterior", " ", "normalised", " ", "field"}], "*)"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Chi]Int", "[", "s_", "]"}], ":=", 
   RowBox[{"g", " ", 
    RowBox[{"Csch", "[", 
     RowBox[{
      RowBox[{"ArcCsch", "[", 
       FractionBox["\[Chi]0", "g"], "]"}], "-", 
      RowBox[{"g", " ", "\[Gamma]", " ", "s"}]}], "]"}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"interior", " ", "normalised", " ", "field"}], "*)"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Chi]", "[", "s_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Chi]Int", "[", "s", "]"}], " ", 
     RowBox[{"\[CapitalTheta]", "[", 
      RowBox[{"-", "s"}], "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"\[Chi]Ext", "[", "s", "]"}], " ", 
     RowBox[{"\[CapitalTheta]", "[", "s", "]"}]}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"full", " ", "normalised", " ", "field"}], "*)"}], ";"}]}], "Input",\

